{
  "name": "orbat-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^24.11.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed": "tsx prisma/seed.ts",
    "seed:dev": "tsx prisma/seed.dev.ts",
    "seed:prod": "tsx prisma/seed.prod.ts",
    "seed:migrate": "tsx prisma/seed.migrate.ts",
    "avatars:migrate": "tsx scripts/migrate-data-urls.ts",
    "test:permissions": "tsx --test tests/*permissions*.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "db:push": "prisma db push",
    "swagger": "node scripts/swagger.mjs",
    "swagger:serve": "node scripts/swagger.mjs",
    "api:inventory": "node scripts/api-inventory.mjs",
    "openapi:refresh": "node scripts/openapi-refresh.mjs",
    "test:api": "vitest run",
    "test:api:coverage": "vitest run --coverage",
    "test:api:integration": "node scripts/test-api-integration.mjs",
    "test:backend": "node scripts/test-api-integration.mjs --backend",
    "audit:prune": "tsx scripts/prune-api-audits.ts",
    "api:check": "node scripts/check-api-contract.mjs",
    "test:ui": "node scripts/test-ui.mjs",
    "ui:check": "node scripts/check-ui-coverage.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "test:workflows": "node --test tests/workflows/*.test.mjs",
    "scheduler": "node --import tsx scripts/scheduler.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "lightningcss": "^1.33.0",
    "next": "^16.3.5",
    "next-auth": "^4.24.15",
    "pg": "^8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "uuid": "^14.0.2",
    "@next/env": "^16.3.5",
    "tsx": "^4.23.13",
    "dotenv": "^18.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@prisma/dev": "0.25.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/estree": "^1.0.9",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^24.13.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/trusted-types": "^2.0.7",
    "@vitest/coverage-v8": "^5.0.1",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "express": "^5.2.1",
    "prisma": "^7.10.0",
    "swagger-ui-dist": "^5.33.0",
    "swagger-ui-express": "^5.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "^5.0.1",
    "yaml": "^2.9.1",
    "@typescript/native": "npm:typescript@^7.0.2"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "prisma": {
      "mysql2": "3.24.4",
      "@prisma/dev": "$@prisma/dev"
    }
  }
}
