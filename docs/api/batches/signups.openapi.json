  "paths": {
    "/signups": {
      "post": {
        "summary": "Create signup",
        "tags": [
          "Signups"
        ],
        "description": "Self signup requires a session only. Other users require live orbat:edit hierarchy. Bots must specify numeric userId. One signup per operation; enforce capacity, schedule, absence, rank and training in Serializable transaction. Side operations skip rank/training only. Slot selection is explicit; no legacy Discord/Steam body aliases. Unknown/repeated query parameters are rejected. All timestamps are UTC ISO strings. Active database bots use superadmin permissions; invalid explicit authorization never falls back to a session.",
        "security": [
          {
            "sessionCookie": []
          },
          {
            "secureSessionCookie": []
          },
          {
            "apiKey": []
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "description": "Optional actor-scoped key. Receipts expire after 24 hours and commit with mutation/audit/outbox. Replayed requests revalidate current target permission."
          }
        ],
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/SignupMutation"
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "warnings": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  },
                  "required": [
                    "data",
                    "meta"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid path query header or malformed JSON"
          },
          "401": {
            "description": "Invalid or missing credentials"
          },
          "403": {
            "description": "Permission or target hierarchy denied"
          },
          "404": {
            "description": "Resource or reference not found"
          },
          "409": {
            "description": "Business rule concurrency or idempotency conflict"
          },
          "422": {
            "description": "Invalid payload"
          },
          "500": {
            "description": "Internal failure; mutation rollback or read audit failure"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignupCreate"
              }
            }
          }
        }
      }
    },
