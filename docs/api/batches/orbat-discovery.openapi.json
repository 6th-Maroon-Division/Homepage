{
  "paths": {
    "/orbats": {
      "get": {
        "tags": [
          "ORBATs"
        ],
        "summary": "List public ORBATs",
        "description": "Public minimal ORBAT directory for anonymous callers, live sessions and active bearer tokens. Invalid explicit credentials fail. Strict single limit/cursor/includePast/startAt/endBefore filters; descending ID pages with genuine lookahead. includePast defaults true; false uses current UTC midnight unless explicit startAt supplied. Zoned startAt is inclusive and endBefore exclusive; legacy date-only operations use UTC eventDate when startsAtUtc is absent. No user data read audit. Retrieve full public operation data through /orbats/{id}/full.",
        "security": [
          {},
          {
            "sessionCookie": []
          },
          {
            "secureSessionCookie": []
          },
          {
            "apiKey": []
          }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 50
            },
            "description": "Values above 100 are clamped to 100."
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^[0-9]+$"
            },
            "description": "Positive Int32 ORBAT ID from meta.nextCursor; returns smaller IDs in descending order."
          },
          {
            "name": "includePast",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": true
            }
          },
          {
            "name": "startAt",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Explicit timezone required."
          },
          {
            "name": "endBefore",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Explicit timezone required."
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/PublicOrbatListItem"
                      }
                    },
                    "meta": {
                      "type": "object",
                      "required": [
                        "limit",
                        "nextCursor"
                      ],
                      "properties": {
                        "limit": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 100
                        },
                        "nextCursor": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid arguments or malformed JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiFailure"
                }
              }
            }
          },
          "401": {
            "description": "Invalid supplied Authorization credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiFailure"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiFailure"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "ORBATs"
        ],
        "summary": "Create an ORBAT",
        "description": "No query parameters are accepted (400 if supplied). Requires orbat:create for session users. Active database bot tokens act as superadmin. User sessions record their creator ID; active superadmin bot tokens create with a null creator, attributed through the audit actor. Deploy the optional-creator database migration first for bot creation. Missing role/frequency references return 404; retired roles or transaction/reference conflicts return 409. A serializable transaction creates operation/squads/slots/frequency links, the existing orbat.created outbox event, and a metadata-only audit without briefing text. Realtime notifications are emitted safely after commit. Returns only data.id; public GET behavior remains unchanged.",
        "security": [
          {
            "sessionCookie": []
          },
          {
            "secureSessionCookie": []
          },
          {
            "apiKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrbatCreateInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "data": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "id"
                      ],
                      "properties": {
                        "id": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 2147483647
                        }
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid arguments or malformed JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiFailure"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid authentication",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiFailure"
                }
              }
            }
          },
          "403": {
            "description": "Insufficient permission",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiFailure"
                }
              }
            }
          },
          "404": {
            "description": "Resource not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiFailure"
                }
              }
            }
          },
          "409": {
            "description": "Conflicting resource state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiFailure"
                }
              }
            }
          },
          "422": {
            "description": "Payload validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiFailure"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiFailure"
                }
              }
            }
          }
        }
      }
    },
    "/orbats/management": {
      "get": {
        "summary": "List operations for management",
        "description": "Live session or bot; any orbat:create/edit/delete permission required. Descending Int32 cursor pages default50 capped100; unknown/repeated queries rejected. Includes operation metadata, minimal creator and counts; excludes participants. Returned other creators audited, fail closed on audit failure. Timestamps UTC Z; nullable creator permits bot-created operations.",
        "security": [
          {
            "sessionCookie": []
          },
          {
            "secureSessionCookie": []
          },
          {
            "apiKey": []
          }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 50
            },
            "description": "Values above 100 are clamped to 100."
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^[0-9]+$"
            },
            "description": "Positive Int32 ORBAT ID from meta.nextCursor; returns smaller IDs in descending order."
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated operation management rows",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/OrbatManagementItem"
                      }
                    },
                    "meta": {
                      "type": "object",
                      "required": [
                        "limit",
                        "nextCursor"
                      ],
                      "properties": {
                        "limit": {
                          "type": "integer"
                        },
                        "nextCursor": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Standard error envelope",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Standard error envelope",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Standard error envelope",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Standard error envelope",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "removePaths": [
    "/admin/orbats/list",
    "/bot/orbats",
    "/bot/orbats/{id}"
  ],
  "components": {
    "schemas": {
      "OrbatManagementItem": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "startsAtUtc",
          "endsAtUtc",
          "eventDate",
          "startTime",
          "endTime",
          "createdAt",
          "createdBy",
          "slotCount",
          "totalSubslots",
          "totalSignups"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "startsAtUtc": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "endsAtUtc": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "eventDate": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "startTime": {
            "type": [
              "string",
              "null"
            ]
          },
          "endTime": {
            "type": [
              "string",
              "null"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "createdBy": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "id",
                  "username"
                ],
                "properties": {
                  "id": {
                    "type": "integer"
                  },
                  "username": {
                    "type": "string"
                  }
                }
              }
            ]
          },
          "slotCount": {
            "type": "integer",
            "minimum": 0
          },
          "totalSubslots": {
            "type": "integer",
            "minimum": 0
          },
          "totalSignups": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
