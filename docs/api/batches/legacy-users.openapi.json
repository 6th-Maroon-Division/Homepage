{
  "paths": {
    "/attendance/legacy-users": {
      "get": {
        "summary": "List legacy user import records",
        "description": "Requires attendance:view. Strict filters, ascending ID cursor with actual lookahead. No embedded directory. Read audits exclude self/lookahead.",
        "security": [
          {
            "sessionCookie": []
          },
          {
            "secureSessionCookie": []
          },
          {
            "apiKey": []
          }
        ],
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 50,
              "description": "Capped at 100"
            }
          },
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          },
          {
            "name": "isMapped",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "isApplied",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LegacyUserListResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query or JSON"
          },
          "401": {
            "description": "Invalid identity"
          },
          "403": {
            "description": "Required permission missing"
          },
          "404": {
            "description": "Reference not found"
          },
          "409": {
            "description": "Concurrent change, applied-data protection or ambiguous target"
          },
          "422": {
            "description": "Invalid payload or CSV"
          },
          "500": {
            "description": "Request/audit failed; transaction rolled back"
          }
        }
      },
      "patch": {
        "summary": "Map legacy user records",
        "description": "Requires system:super_admin. Up to 100 unique IDs, input-order response; all references preflight before atomic update/audit. Applied records cannot change target. No query arguments.",
        "security": [
          {
            "sessionCookie": []
          },
          {
            "secureSessionCookie": []
          },
          {
            "apiKey": []
          }
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LegacyUserMappingResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query or JSON"
          },
          "401": {
            "description": "Invalid identity"
          },
          "403": {
            "description": "Required permission missing"
          },
          "404": {
            "description": "Reference not found"
          },
          "409": {
            "description": "Concurrent change, applied-data protection or ambiguous target"
          },
          "422": {
            "description": "Invalid payload or CSV"
          },
          "500": {
            "description": "Request/audit failed; transaction rolled back"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LegacyUserMappingInput"
              }
            }
          }
        }
      }
    },
    "/attendance/legacy-users/import": {
      "post": {
        "summary": "Preview or import legacy user CSV",
        "description": "Requires attendance:edit; autoMap additionally requires system:super_admin. Maximum 1000 rows; quoted CSV, exact seven headers in any order. Strict nonnegative counts; valid DD/MM/YYYY or YYYY-MM-DD becomes calendar date. Existing legacy IDs skipped; unknown ranks retained with notes. Only unambiguous username matches auto-map. Preview does not insert, commit audits IDs/counts. No query arguments.",
        "security": [
          {
            "sessionCookie": []
          },
          {
            "secureSessionCookie": []
          },
          {
            "apiKey": []
          }
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LegacyUserImportResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query or JSON"
          },
          "401": {
            "description": "Invalid identity"
          },
          "403": {
            "description": "Required permission missing"
          },
          "404": {
            "description": "Reference not found"
          },
          "409": {
            "description": "Concurrent change, applied-data protection or ambiguous target"
          },
          "422": {
            "description": "Invalid payload or CSV"
          },
          "500": {
            "description": "Request/audit failed; transaction rolled back"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LegacyUserImportInput"
              }
            }
          }
        }
      }
    },
    "/attendance/legacy-users/apply": {
      "post": {
        "summary": "Apply bounded legacy user records",
        "description": "Requires system:super_admin. Unique explicit IDs; already applied IDs skipped. Missing/unmapped/ambiguous targets and invalid ranks/dates reject before writes. Rank baseline, history, outbox, applied flags and per-user audits commit atomically. Preserves status flags; timestamps are UTC. No query arguments.",
        "security": [
          {
            "sessionCookie": []
          },
          {
            "secureSessionCookie": []
          },
          {
            "apiKey": []
          }
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LegacyUserApplyResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query or JSON"
          },
          "401": {
            "description": "Invalid identity"
          },
          "403": {
            "description": "Required permission missing"
          },
          "404": {
            "description": "Reference not found"
          },
          "409": {
            "description": "Concurrent change, applied-data protection or ambiguous target"
          },
          "422": {
            "description": "Invalid payload or CSV"
          },
          "500": {
            "description": "Request/audit failed; transaction rolled back"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LegacyUserApplyInput"
              }
            }
          }
        }
      }
    }
  },
