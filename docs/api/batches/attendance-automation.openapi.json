  "components": {
    "schemas": {
      "AttendanceEventInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "userId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "identity": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "provider": {
                "type": "string",
                "enum": [
                  "steam",
                  "discord"
                ]
              },
              "providerUserId": {
                "type": "string",
                "pattern": "^[1-9][0-9]{16,19}$"
              }
            },
            "required": [
              "provider",
              "providerUserId"
            ]
          },
          "isJoin": {
            "type": "boolean"
          },
          "eventTime": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "isJoin",
          "eventTime"
        ],
        "oneOf": [
          {
            "required": [
              "userId"
            ],
            "not": {
              "required": [
                "identity"
              ]
            }
          },
          {
            "required": [
              "identity"
            ],
            "not": {
              "required": [
                "userId"
              ]
            }
          }
        ]
      },
      "AttendanceEventResult": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "userId": {
            "type": [
              "integer",
              "null"
            ]
          },
          "isJoin": {
            "type": "boolean"
          },
          "eventTime": {
            "type": "string",
            "format": "date-time"
          },
          "processed": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "userId",
          "isJoin",
          "eventTime",
          "processed"
        ]
      },
      "AttendanceSessionInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "userId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "orbatId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "checkinTime": {
            "type": "string",
            "format": "date-time"
          },
          "checkoutTime": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
