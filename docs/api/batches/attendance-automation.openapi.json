{
  "paths": {
    "/attendance/events": {
      "post": {
        "tags": [
          "Attendance automation"
        ],
        "summary": "Record raw attendance event",
        "description": "Exactly one numeric userId or provider identity. Unknown identities remain pending for backfill; provider values are not returned or copied to audit. Consecutive identical-direction events are deduplicated only within the same resolved user/provider identity; out-of-order earlier events remain accepted. New event201; duplicate200 with existing event DTO. Global attendance:edit required for live sessions and active database bots. Known targets require current permission hierarchy, even on replay/duplicate resolution. Unknown/repeated query parameters are rejected. Timestamps require explicit offsets and normalize to UTC ISO. Effects and metadata-only audits share one Serializable transaction.",
        "security": [
          {
            "sessionCookie": []
          },
          {
            "secureSessionCookie": []
          },
          {
            "apiKey": []
          }
        ],
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AttendanceEventInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/AttendanceEventResult"
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "duplicate": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "duplicate"
                      ]
                    }
                  },
                  "required": [
                    "data",
                    "meta"
                  ]
                }
              }
            }
          },
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/AttendanceEventResult"
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "duplicate": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "duplicate"
                      ]
                    }
                  },
                  "required": [
                    "data",
                    "meta"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid path query or malformed JSON"
          },
          "401": {
            "description": "Missing or invalid credentials"
          },
          "403": {
            "description": "Missing attendance:edit or target hierarchy denial"
          },
          "404": {
            "description": "Referenced user or operation not found"
          },
          "409": {
            "description": "Concurrent state, identity, chronology or side-operation conflict"
          },
          "422": {
            "description": "Invalid payload or missing schedule"
          },
          "500": {
            "description": "Internal failure; transaction rolled back"
          }
        }
      }
    },
    "/attendance/events/backfill": {
      "post": {
        "tags": [
          "Attendance automation"
        ],
        "summary": "Link pending attendance events",
        "description": "Ascending ID processing, default100/max1000 with actual lookahead cursor. All resolved targets are preflighted before any write. Unmatched records stay pending. Conflicting provider/user matches reject409 atomically. Cursor is numeric in payload, string in metadata; start without cursor to revisit previously-unmatched rows. Global attendance:edit required for live sessions and active database bots. Known targets require current permission hierarchy, even on replay/duplicate resolution. Unknown/repeated query parameters are rejected. Timestamps require explicit offsets and normalize to UTC ISO. Effects and metadata-only audits share one Serializable transaction.",
        "security": [
          {
            "sessionCookie": []
          },
          {
            "secureSessionCookie": []
          },
          {
            "apiKey": []
          }
        ],
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AttendanceBackfillInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/AttendanceBackfillResult"
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "limit": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "nextCursor": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "required": [
                        "limit",
                        "nextCursor"
                      ]
                    }
                  },
                  "required": [
                    "data",
                    "meta"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid path query or malformed JSON"
          },
          "401": {
            "description": "Missing or invalid credentials"
          },
          "403": {
            "description": "Missing attendance:edit or target hierarchy denial"
          },
          "404": {
            "description": "Referenced user or operation not found"
          },
          "409": {
            "description": "Concurrent state, identity, chronology or side-operation conflict"
          },
          "422": {
            "description": "Invalid payload or missing schedule"
          },
          "500": {
            "description": "Internal failure; transaction rolled back"
          }
        }
      }
    },
    "/attendance/sessions": {
      "post": {
        "tags": [
          "Attendance automation"
        ],
        "summary": "Record checkin or checkout session",
        "description": "Explicit orbatId attaches session to that operation, creating attendance even without signup. Omitted orbatId retains an unattached raw session and recalculates signed-up main operations overlapping its day, including overnight operations. One open session per user/mode; identical open checkin may be repeated, conflicting checkin409, missing checkout source409, checkout before checkin422. New bot session behavior uses shared overlap clipping and first/last-hour grace rather than the removed inconsistent60-minute heuristic. Closed-session retries need application-level event handling; this endpoint has no receipt header. Side operations cannot receive compiled attendance; global raw sessions still persist. UTC sessionDate midnight; raw duration ceil minutes while counted presence uses existing helper math. Global attendance:edit required for live sessions and active database bots. Known targets require current permission hierarchy, even on replay/duplicate resolution. Unknown/repeated query parameters are rejected. Timestamps require explicit offsets and normalize to UTC ISO. Effects and metadata-only audits share one Serializable transaction.",
        "security": [
          {
            "sessionCookie": []
          },
          {
            "secureSessionCookie": []
          },
          {
            "apiKey": []
          }
        ],
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AttendanceSessionInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/AttendanceSessionResult"
                    },
                    "meta": {
                      "type": "object"
                    }
                  },
                  "required": [
                    "data",
                    "meta"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid path query or malformed JSON"
          },
          "401": {
            "description": "Missing or invalid credentials"
          },
          "403": {
            "description": "Missing attendance:edit or target hierarchy denial"
          },
          "404": {
            "description": "Referenced user or operation not found"
          },
          "409": {
            "description": "Concurrent state, identity, chronology or side-operation conflict"
          },
          "422": {
            "description": "Invalid payload or missing schedule"
          },
          "500": {
            "description": "Internal failure; transaction rolled back"
          }
        }
      }
    },
    "/orbats/{id}/attendance/compile": {
      "post": {
        "tags": [
          "Attendance automation"
        ],
        "summary": "Compile raw events for an operation",
        "description": "Requires start/end window; side operations409. Includes events within a six-hour boundary buffer, clamps segments, preserves original start-only full-presence rule, ignores repeated joins while already joined, and creates deterministic no_show for signups with no joins. All signup targets authorize before writes. Existing records update instead of duplicating. All attendance records, logs and per-user audits are atomic; repeated compile retains record identity though logs/audits record each run. Global attendance:edit required for live sessions and active database bots. Known targets require current permission hierarchy, even on replay/duplicate resolution. Unknown/repeated query parameters are rejected. Timestamps require explicit offsets and normalize to UTC ISO. Effects and metadata-only audits share one Serializable transaction.",
        "security": [
          {
            "sessionCookie": []
          },
          {
            "secureSessionCookie": []
          },
          {
            "apiKey": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {}
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/AttendanceCompileResult"
                    },
                    "meta": {
                      "type": "object"
                    }
                  },
                  "required": [
                    "data",
                    "meta"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid path query or malformed JSON"
          },
          "401": {
            "description": "Missing or invalid credentials"
          },
          "403": {
            "description": "Missing attendance:edit or target hierarchy denial"
          },
          "404": {
            "description": "Referenced user or operation not found"
          },
          "409": {
            "description": "Concurrent state, identity, chronology or side-operation conflict"
          },
          "422": {
            "description": "Invalid payload or missing schedule"
          },
          "500": {
            "description": "Internal failure; transaction rolled back"
          }
        }
      }
    }
