          "compiledAt",
          "compiledCount",
          "totalEventsProcessed",
          "attendance"
        ]
      }
    }
  },
  "removePaths": [
    "/attendance/automated",
    "/orbats/{id}/attendance/automation",
    "/bot/attendance",
