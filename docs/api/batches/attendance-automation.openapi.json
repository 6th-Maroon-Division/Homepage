          "attendance": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2147483647
                },
                "userId": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2147483647
                },
