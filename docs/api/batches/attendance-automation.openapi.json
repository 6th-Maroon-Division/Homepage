                "minutesLate": {
                  "type": "integer",
                  "minimum": 0
                },
                "minutesGoneEarly": {
                  "type": "integer",
                  "minimum": 0
                },
                "totalMinutesMissed": {
                  "type": "integer",
                  "minimum": 0
                },
                "notedAbsent": {
                  "type": "boolean"
                },
                "notedLateEarly": {
                  "type": "boolean"
                },
                "notedUnsure": {
                  "type": "boolean"
                },
                "joinCount": {
                  "type": "integer",
                  "minimum": 0
                },
                "leaveCount": {
                  "type": "integer",
                  "minimum": 0
