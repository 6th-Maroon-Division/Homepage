{
  "paths": {
    "/messages": {
      "post": {
        "summary": "Send inbox message",
        "description": "Superadmin session or bot. Strict fields; expands recipients inside the Serializable transaction and atomically writes all deliveries plus metadata-only audit. No message body/title/action URL in audit. Postcommit realtime notification. Returns minimal creation receipt.",
        "security": [
          {
            "sessionCookie": []
          },
          {
            "secureSessionCookie": []
          },
          {
            "apiKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "title",
                  "body",
                  "audience"
                ],
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "body": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 10000
                  },
                  "type": {
                    "enum": [
                      "orbat",
                      "training",
                      "rankup",
                      "general",
                      "alert"
                    ],
                    "default": "general"
                  },
                  "actionUrl": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 2000,
                    "description": "HTTP(S) or same-origin absolute path; no credentials, whitespace or backslashes."
                  },
                  "audience": {
                    "oneOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "type"
                        ],
                        "properties": {
                          "type": {
                            "enum": [
                              "all",
                              "admin"
                            ]
                          }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "type",
                          "userIds"
                        ],
                        "properties": {
                          "type": {
                            "const": "users"
                          },
                          "userIds": {
                            "type": "array",
                            "minItems": 1,
                            "maxItems": 1000,
                            "uniqueItems": true,
                            "items": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 2147483647
                            }
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Canonical success envelope",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "data": {
                      "type": "object",
                      "required": [
                        "id",
                        "createdAt",
                        "recipientCount"
                      ],
                      "properties": {
                        "id": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 2147483647
                        },
                        "createdAt": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "recipientCount": {
                          "type": "integer"
                        }
                      }
                    },
                    "meta": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Standard error envelope"
          },
          "401": {
            "description": "Standard error envelope"
          },
          "403": {
            "description": "Standard error envelope"
          },
          "404": {
            "description": "Standard error envelope"
          },
          "409": {
            "description": "Standard error envelope"
          },
          "422": {
            "description": "Standard error envelope"
          },
          "500": {
            "description": "Standard error envelope"
          }
        }
      }
    },
    "/users/{id}/messages": {
      "get": {
        "summary": "Read inbox",
        "description": "Owner or superadmin session/bot. Session-only me alias. Descending recipient IDs; strict query keys with actual lookahead. meta includes limit, nextCursor and total unreadCount across inbox. Only explicit message DTO fields. Returned other-user inbox/creator IDs audited without snapshots; self with no other creator data has no read audit.",
        "security": [
          {
            "sessionCookie": []
          },
          {
            "secureSessionCookie": []
          },
          {
            "apiKey": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2147483647
                },
                {
                  "type": "string",
                  "const": "me"
                }
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 50
            },
            "description": "Capped100."
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^[0-9]+$"
            }
          },
          {
            "name": "type",
            "in": "query",
            "schema": {
              "enum": [
                "orbat",
                "training",
                "rankup",
                "general",
                "alert"
              ]
            }
          },
          {
            "name": "unread",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Canonical success envelope",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/InboxMessage"
                      }
                    },
                    "meta": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Standard error envelope"
          },
          "401": {
            "description": "Standard error envelope"
          },
          "403": {
            "description": "Standard error envelope"
          },
          "404": {
            "description": "Standard error envelope"
          },
          "409": {
            "description": "Standard error envelope"
          },
          "422": {
            "description": "Standard error envelope"
          },
          "500": {
            "description": "Standard error envelope"
          }
        }
      },
      "patch": {
        "summary": "Mark inbox messages read",
        "description": "Owner or superadmin session/bot. Strict body {isRead:true}; all unread deliveries change atomically with a target-ID audit. No-op does not create a mutation audit. Recipient route affects only the named recipient belonging to this inbox. UTC readAt. No query parameters.",
        "security": [
          {
            "sessionCookie": []
          },
          {
            "secureSessionCookie": []
          },
          {
            "apiKey": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2147483647
                },
                {
                  "type": "string",
                  "const": "me"
                }
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "isRead"
                ],
                "properties": {
                  "isRead": {
                    "const": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Canonical success envelope",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "data": {
                      "type": "object",
                      "required": [
                        "updatedCount"
                      ],
                      "properties": {
                        "updatedCount": {
                          "type": "integer"
                        }
                      }
                    },
                    "meta": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Standard error envelope"
          },
          "401": {
            "description": "Standard error envelope"
          },
          "403": {
            "description": "Standard error envelope"
          },
          "404": {
            "description": "Standard error envelope"
          },
          "409": {
            "description": "Standard error envelope"
          },
          "422": {
            "description": "Standard error envelope"
          },
          "500": {
            "description": "Standard error envelope"
          }
        }
      }
    },
    "/users/{id}/messages/{recipientId}": {
      "patch": {
        "summary": "Mark inbox messages read",
        "description": "Owner or superadmin session/bot. Strict body {isRead:true}; all unread deliveries change atomically with a target-ID audit. No-op does not create a mutation audit. Recipient route affects only the named recipient belonging to this inbox. UTC readAt. No query parameters.",
        "security": [
          {
            "sessionCookie": []
          },
