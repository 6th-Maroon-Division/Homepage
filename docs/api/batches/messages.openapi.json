          },
          {
            "apiKey": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2147483647
                },
                {
                  "type": "string",
                  "const": "me"
                }
              ]
            }
          },
          {
            "name": "recipientId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "isRead"
                ],
                "properties": {
                  "isRead": {
                    "const": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Canonical success envelope",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "data": {
                      "type": "object",
                      "required": [
                        "updatedCount"
                      ],
                      "properties": {
                        "updatedCount": {
                          "type": "integer"
                        }
                      }
                    },
                    "meta": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Standard error envelope"
          },
          "401": {
            "description": "Standard error envelope"
          },
          "403": {
            "description": "Standard error envelope"
          },
          "404": {
            "description": "Standard error envelope"
          },
          "409": {
            "description": "Standard error envelope"
          },
          "422": {
            "description": "Standard error envelope"
          },
          "500": {
            "description": "Standard error envelope"
          }
        }
      }
    }
  },
  "removePaths": [
    "/messaging/send",
    "/messaging/inbox",
    "/messaging/read-all",
    "/messaging/{id}/read"
  ],
  "components": {
    "schemas": {
      "InboxMessage": {
        "type": "object",
        "required": [
          "id",
          "messageId",
          "title",
          "body",
          "type",
          "actionUrl",
          "isRead",
          "readAt",
          "deliveredAt",
          "createdAt",
          "createdBy"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "messageId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "type": {
            "enum": [
              "orbat",
              "training",
              "rankup",
              "general",
              "alert"
            ]
          },
          "actionUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "isRead": {
            "type": "boolean"
          },
          "readAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "deliveredAt": {
            "type": "string",
            "format": "date-time"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "createdBy": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "id",
                  "username"
                ],
                "properties": {
                  "id": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2147483647
                  },
                  "username": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
